# Engine12 Environment Configuration
# Copy this file to .env and customize for your environment.
# System environment variables take precedence over values in this file.

# =============================================================================
# Application Environment
# =============================================================================
# Options: development, staging, production
E12_ENV=development

# =============================================================================
# Server Configuration
# =============================================================================
E12_HOST=127.0.0.1
E12_PORT=8080
E12_WORKERS=12
# E12_READ_TIMEOUT=10000
# E12_WRITE_TIMEOUT=10000
# E12_MAX_BODY_SIZE=10485760

# =============================================================================
# Database Configuration
# =============================================================================
# Options: sqlite, postgresql
E12_DB_DRIVER=sqlite

# SQLite Configuration
E12_DB_PATH=app.db

# PostgreSQL Configuration (required if E12_DB_DRIVER=postgresql)
# E12_DB_HOST=127.0.0.1
# E12_DB_PORT=5432
# E12_DB_NAME=myapp
# E12_DB_USER=postgres
# E12_DB_PASSWORD=secret

# =============================================================================
# Logging Configuration
# =============================================================================
# Options: debug, info, warn, error
E12_LOG_LEVEL=debug
E12_LOG_REQUESTS=true

# =============================================================================
# Cache Configuration
# =============================================================================
E12_CACHE_ENABLED=true
E12_CACHE_TTL=60000

# =============================================================================
# Security (Required in Production)
# =============================================================================
# Generate a secure random key for production use
# E12_SECRET_KEY=your-secure-random-key-here
